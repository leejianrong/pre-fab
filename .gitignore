!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.turbo/
.eslintcache

# Subagent slot counter (runtime state, see .claude/hooks/agent-limit.sh)
.claude/.agent-slots/
