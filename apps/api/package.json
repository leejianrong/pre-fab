{
  "name": "@prefab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mutations": "./src/mutations.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/*.integration.test.ts --testTimeout=60000 --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.3.0",
    "@prefab/blocks": "workspace:*",
    "@prefab/db": "workspace:*",
    "@prefab/publish": "workspace:*",
    "@prefab/runtime": "workspace:*",
    "@prefab/schema": "workspace:*",
    "@prefab/templates": "workspace:*",
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "dotenv": "16.4.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
