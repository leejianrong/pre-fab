# packages/db migrations (owns the schema — never used at API runtime)
MIGRATE_DATABASE_URL=postgres://prefab:prefab@localhost:5432/prefab_dev
MIGRATE_DATABASE_URL_TEST=postgres://prefab:prefab@localhost:5432/prefab_test

# apps/api runtime (non-owner grantee, so RLS applies unconditionally — ADR-0008)
DATABASE_URL=postgres://prefab_app:prefab_app@localhost:5432/prefab_dev
DATABASE_URL_TEST=postgres://prefab_app:prefab_app@localhost:5432/prefab_test
API_PORT=8787
PUBLIC_SITE_HOST=prefab.local
BUNDLE_STORE_DIR=.data/bundles
ASSET_STORE_DIR=.data/assets
EDITOR_ORIGIN=http://localhost:5173

# apps/cli / apps/mcp
PREFAB_API_URL=http://localhost:8787
PREFAB_TOKEN=

# apps/editor
VITE_PREFAB_API_URL=http://localhost:8787
