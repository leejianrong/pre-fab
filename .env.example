# packages/db migrations (owns the schema — never used at API runtime)
MIGRATE_DATABASE_URL=postgres://prefab:prefab@localhost:5432/prefab_dev
MIGRATE_DATABASE_URL_TEST=postgres://prefab:prefab@localhost:5432/prefab_test

# apps/api runtime (non-owner grantee, so RLS applies unconditionally — ADR-0008)
DATABASE_URL=postgres://prefab_app:prefab_app@localhost:5432/prefab_dev
DATABASE_URL_TEST=postgres://prefab_app:prefab_app@localhost:5432/prefab_test
API_PORT=8787
PUBLIC_SITE_HOST=prefab.local
BUNDLE_STORE_DIR=.data/bundles
ASSET_STORE_DIR=.data/assets
EDITOR_ORIGIN=http://localhost:5173

# Slice 4 custom domains — optional. Unset (the default everywhere in this
# repo, including CI) uses an in-memory FakeDomainProvider instead of real
# Cloudflare, driven via the dev-only /v1/dev/domains/:id/advance endpoint.
# Set both to use the real (unverified — see apps/api/src/lib/domain-provider.ts) adapter.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Slice 6 forms and submissions — all optional, same "fake by default"
# discipline as the Cloudflare/email adapters above.
#
# Where a published site's Form island posts submissions to (its own
# origin's API — apps.api mounts the runtime API alongside the control
# plane). Unset means the island renders but declines to submit (safe
# for an offline local build, R16).
RUNTIME_API_URL=http://localhost:8787
# Real Resend only when both are set — see apps/api/src/lib/email.ts's
# ResendEmailSender (UNVERIFIED — no live Resend account in this
# environment). Unset uses the same in-memory outbox signup's
# verification codes already use.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# Real Cloudflare Turnstile only when the secret key is set — see
# apps/api/src/lib/turnstile.ts (UNVERIFIED). Unset uses a fake verifier
# that always succeeds; forms default to Turnstile disabled anyway.
TURNSTILE_SECRET_KEY=
# Turnstile's public site key — not a secret, safe to ship in a bundle.
# Only used when a form has Turnstile explicitly enabled.
TURNSTILE_SITE_KEY=

# Slice 8 accounts, plans and billing — *our* billing only, never a
# tenant's own bring-your-own Stripe (ADR-0005, milestone 2, not built
# yet). All optional, same "fake by default" discipline as above.
#
# Real Stripe only when the secret key is set — see
# apps/api/src/lib/stripe.ts's RealStripeProvider (UNVERIFIED — no live
# Stripe account in this environment). Unset uses FakeStripeProvider and
# the dev-only /v1/dev/stripe/:accountId/advance endpoint instead.
STRIPE_SECRET_KEY=
# Required to verify real inbound webhook signatures (POST /v1/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=
# The Stripe Price id for the pro plan's checkout line item.
STRIPE_PRICE_ID_PRO=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# Slice 9 scheduling and bookings (ADR-0009) — two-way Google Calendar /
# Microsoft 365 sync, all optional, same "fake by default" discipline as
# above. No real Google/Microsoft developer account exists in this
# environment, so every test runs against an in-memory FakeCalendarProvider,
# driven via the dev-only /v1/dev/calendar/:siteId/advance endpoint. Set a
# provider's client id/secret to use its real (UNVERIFIED — see
# apps/api/src/lib/calendar-provider.ts) adapter for that provider only;
# the other stays fake independently.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Defaults to "common" (Microsoft's own multi-tenant default) — set to a
# specific Azure AD tenant id if the app registration requires one.
MICROSOFT_CALENDAR_TENANT=

# apps/cli / apps/mcp
PREFAB_API_URL=http://localhost:8787
PREFAB_TOKEN=

# apps/editor
VITE_PREFAB_API_URL=http://localhost:8787

# docker-compose.yml only (`make dev`/`make up`) — host ports published to
# your laptop. Override any of these if it collides with another project's
# dev stack; nothing else needs to change. PREFAB_PROXY_PORT is nginx's own
# port, fronting the editor UI at http://pre-fab.localhost:<that port>.
PREFAB_PROXY_PORT=5170
PREFAB_API_HOST_PORT=8787
PREFAB_POSTGRES_PORT=5432
