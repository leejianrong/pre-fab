{
  "name": "@prefab/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/cli/migrate.ts",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/*.integration.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@prefab/schema": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "dotenv": "17.4.2",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
