{
  "name": "@prefab/commands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/*.integration.test.ts --testTimeout=60000"
  },
  "dependencies": {
    "@prefab/schema": "workspace:*",
    "@prefab/blocks": "workspace:*",
    "@prefab/publish": "workspace:*",
    "@prefab/api-client": "workspace:*",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@prefab/api": "workspace:*",
    "@prefab/db": "workspace:*",
    "@types/pg": "8.11.10",
    "dotenv": "16.4.7",
    "pg": "8.13.1",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
