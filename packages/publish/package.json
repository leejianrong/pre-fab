{
  "name": "@prefab/publish",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/*.integration.test.ts --testTimeout=60000"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@prefab/blocks": "workspace:*",
    "@prefab/schema": "workspace:*",
    "astro": "7.2.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
